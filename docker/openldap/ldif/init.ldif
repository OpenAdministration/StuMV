dn: cn=config
objectClass: olcGlobal
cn: config
olcLogLevel: conns
olcLogLevel: config
olcTLSCipherSuite: HIGH:MEDIUM:+3DES:+RC4:+aNULL
olcTLSCRLCheck: none
olcTLSVerifyClient: never
olcTLSProtocolMin: 3.1

dn: cn=module{0},cn=config
objectClass: olcModuleList
dn: cn=module{0}
olcModuleLoad: {0}ppolicy
olcModuleLoad: {1}argon2
olcModuleLoad: {2}dynlist

dn: olcDatabase={1}mdb,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: {1}mdb
olcDbDirectory: /var/lib/openldap/data
olcSuffix: dc=stumv,dc=de
olcRootDN: cn=admin,dc=stumv,dc=de
olcRootPW: 
olcAccess: {0}to attrs=userPassword by self write by anonymous auth by * none
olcAccess: {1}to * by * read

dn: olcOverlay={0}dynlist,olcDatabase={1}mdb,cn=config
objectClass: olcDynamicList
objectClass: olcOverlayConfig
olcOverlay: {0}dynlist
olcDlAttrSet: groupOfURLs memberURL uniqueMember+memberOf@groupOfUniqueNames

olcDatabase={-1}frontend,cn=config
objectClass: olcDatabaseConfig
objectClass: olcFrontendConfig
olcPasswordHash: {ARGON2}
