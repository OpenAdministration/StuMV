# --- demo community skeleton --------------------------------------------
dn: ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: demo
description: StuFiS Demo-Mandant

dn: ou=Groups,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Groups
description: The Groups

dn: ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Committees
description: The Committees

dn: ou=Domains,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Domains
description: The Domains

# Registerable domain: users with an @demo.stumv.de address can self-register
# into the demo community.
dn: dc=demo.stumv.de,ou=Domains,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: domain
objectClass: top
dc: demo.stumv.de

# --- community-level membership groups ----------------------------------
dn: cn=admins,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: admins
uniqueMember: uid=demo-stura,ou=People,dc=stumv,dc=de

dn: cn=moderators,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: moderators
uniqueMember: uid=demo-hhv,ou=People,dc=stumv,dc=de
uniqueMember: uid=demo-kv,ou=People,dc=stumv,dc=de

dn: cn=members,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: members
uniqueMember: uid=demo-hhv,ou=People,dc=stumv,dc=de
uniqueMember: uid=demo-kv,ou=People,dc=stumv,dc=de
uniqueMember: uid=demo-revision,ou=People,dc=stumv,dc=de
uniqueMember: uid=demo-stura,ou=People,dc=stumv,dc=de
uniqueMember: uid=demo-fsr,ou=People,dc=stumv,dc=de
uniqueMember: uid=demo-studi,ou=People,dc=stumv,dc=de

# --- committees and their roles -----------------------------------------
# StuRa (Studierendenrat) holds the financial-oversight roles that the
# ThürStudFVO keeps separate.
dn: ou=StuRa,ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: StuRa
description: Studierendenrat (Demo)

dn: cn=Mitglied,ou=StuRa,ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: Mitglied
uniqueMember: uid=demo-stura,ou=People,dc=stumv,dc=de

dn: cn=Haushaltsverantwortliche,ou=StuRa,ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: Haushaltsverantwortliche
uniqueMember: uid=demo-hhv,ou=People,dc=stumv,dc=de

dn: cn=Kassenverantwortliche,ou=StuRa,ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: Kassenverantwortliche
uniqueMember: uid=demo-kv,ou=People,dc=stumv,dc=de

dn: cn=Revision,ou=StuRa,ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: Revision
uniqueMember: uid=demo-revision,ou=People,dc=stumv,dc=de

# FSR (Fachschaftsrat) — department-level council.
dn: ou=FSR,ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: FSR
description: Fachschaftsrat (Demo)

dn: cn=Mitglied,ou=FSR,ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: Mitglied
uniqueMember: uid=demo-fsr,ou=People,dc=stumv,dc=de
