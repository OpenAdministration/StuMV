# Demo realm for development / manual testing, mirroring the public StuFiS demo
# (https://stufis.de/demo-login). Provides a "demo" community with the standard
# skeleton plus six ready-to-use logins covering the ThürStudFVO separation of
# financial responsibilities. All demo accounts share the password
# "Demo-password1" (cleartext here so slapadd stores it verbatim; a simple bind
# still compares fine, exactly like the admin/alice sample accounts).
#
# Structure produced here is what `php artisan community:new demo` +
# registration would create: ou=demo community with Groups/Committees/Domains
# sub-OUs, admins/moderators/members groups, a registerable domain, committees
# (StuRa, FSR) and roles (groupOfUniqueNames) under them.

# --- demo people --------------------------------------------------------
dn: uid=demo-hhv,ou=People,dc=stumv,dc=de
objectClass: inetOrgPerson
objectClass: top
uid: demo-hhv
cn: Hanna Haushalt
sn: Haushalt
givenName: Hanna
mail: demo-hhv@demo.stumv.de
description: Demo: Haushaltsverantwortliche (Budget Manager)
userPassword: Demo-password1

dn: uid=demo-kv,ou=People,dc=stumv,dc=de
objectClass: inetOrgPerson
objectClass: top
