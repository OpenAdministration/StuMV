# Demo realm for development / manual testing, mirroring the public StuFiS demo
# (https://stufis.de/demo-login). Provides a "demo" community with the standard
# skeleton plus six ready-to-use logins covering the ThürStudFVO separation of
# financial responsibilities. All demo accounts share the password
# "Demo-password1" (cleartext here so slapadd stores it verbatim; a simple bind
# still compares fine, exactly like the admin sample account).
#
# Structure produced here is what `php artisan community:new demo` +
# registration would create: ou=demo community with People/Groups/Committees/
# Domains sub-OUs, admins/moderators groups, a registerable domain, committees
# (StuRa, FSR) and roles (groupOfUniqueNames) under them. Membership is the
# location itself now (see Community::generateSkeleton()) - there is no
# separate "members" group - so the people entries below must come after the
# community skeleton that provides their parent ou=People OU.

# --- demo community skeleton --------------------------------------------
dn: ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: demo
description: StuFiS Demo-Mandant

dn: ou=People,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: People
description: The People

dn: ou=Groups,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Groups
description: The Groups

dn: ou=Committees,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Committees
description: The Committees

dn: ou=Domains,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Domains
description: The Domains

# Registerable domain: users with an @demo.stumv.de address can self-register
# into the demo community.
dn: dc=demo.stumv.de,ou=Domains,ou=demo,ou=Communities,dc=stumv,dc=de
objectClass: domain
objectClass: top
dc: demo.stumv.de

