# Structural bootstrap for the StuMV directory (development / CI).
# Baked into the image; every container start begins from this clean state.

dn: dc=stumv,dc=de
objectClass: dcObject
objectClass: organization
dc: stumv
o: Studentische Mitgliederverwaltung

dn: ou=People,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: People

dn: ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Communities

dn: ou=Policies,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Policies

# Referenced by the ppolicy overlay's olcPPolicyDefault (config.ldif) - lockout
# stays off here (see that entry's comment), so this exists purely to let the
# overlay attach and start tracking pwdLastSuccess on every bind.
dn: cn=default,ou=Policies,dc=stumv,dc=de
objectClass: pwdPolicy
objectClass: device
cn: default
pwdAttribute: userPassword
pwdLockout: FALSE

dn: ou=Services,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Services

# --- service/bind account used by the application ------------------------
# Password is a throwaway development credential (see .env.docker).
# posixAccount is added so this is the *only* entry that satisfies
# phpLDAPadmin's default login objectClass (posixAccount) — i.e. the service
# account is the only account that can sign in to the phpLDAPadmin web UI.
dn: uid=stumv,ou=Services,dc=stumv,dc=de
objectClass: account
objectClass: simpleSecurityObject
objectClass: posixAccount
objectClass: top
uid: stumv
cn: StuMV Service Account
uidNumber: 1000
gidNumber: 1000
homeDirectory: /nonexistent
loginShell: /usr/sbin/nologin
description: StuMV application service/bind account (development/CI only)
userPassword: stumv-not-production

# --- permission groups referenced by the ACLs ---------------------------
# The service account must be a member of cn=write to be able to write.
dn: ou=Permissions,ou=Services,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: Permissions

dn: cn=write,ou=Permissions,ou=Services,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: write
uniqueMember: uid=stumv,ou=Services,dc=stumv,dc=de

dn: cn=read,ou=Permissions,ou=Services,dc=stumv,dc=de
objectClass: groupOfUniqueNames
objectClass: top
cn: read
uniqueMember: uid=stumv,ou=Services,dc=stumv,dc=de

# --- dedicated "admin" realm ---------------------------------------------
# Superadmins live here instead of a global super-admins group - see
# Community::generateSkeleton(full: false): just the community OU and its
# People branch, no Groups/Committees/Domains/admins/moderators of its own
# (its members get moderator/admin/superadmin rights everywhere via
# CommunityPolicy instead). The actual admin person entry lives in
# 10-sample.ldif, alongside its independent testcom-member clone.
dn: ou=admin,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: admin
description: Superadmins

dn: ou=People,ou=admin,ou=Communities,dc=stumv,dc=de
objectClass: organizationalUnit
objectClass: top
ou: People
description: The People
