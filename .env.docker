# Environment for the docker-compose.dev.yaml stack.
#
# Used BOTH as the compose interpolation source (run with
# `podman compose --env-file .env.docker ...`) AND injected into the app
# containers via `env_file:`. Because Laravel's dotenv loader is immutable,
# these injected values win over the bind-mounted host .env — so the app talks
# to the in-network services (ldap/mariadb) regardless of your host .env.
#
# Hosts are compose SERVICE NAMES and ports are the IN-CONTAINER ports. The
# *_HOST_PORT vars are only the ports published to your host machine.

# php-fpm / workspace run as your host user so bind-mounted files stay writable.
UID=1000
GID=1000

APP_NAME=StuMV
APP_ENV=local
APP_KEY=base64:GszA3F2jJK0Rdh52FvnWj3MDarPc+ftA+e0MpqqbFMQ=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- MariaDB (service name "mariadb", in-container port 3306) --------------
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=stumv
DB_USERNAME=stumv
DB_PASSWORD=local_stumv_password
DB_HOST_PORT=13306
# phpMyAdmin web UI (http://localhost:8082)
DB_ADMIN_PORT=8082

# --- OpenLDAP (service name "ldap", in-container port 1389) ----------------
# Throwaway dev bind credentials baked into docker/openldap seed data.
LDAP_ORGANISATION="StuMV"
LDAP_LOGGING=true
LDAP_CONNECTION=default
LDAP_HOST=ldap
LDAP_PORT=1389
LDAP_USERNAME="uid=stumv,ou=Services,dc=stumv,dc=de"
LDAP_PASSWORD=stumv-not-production
LDAP_BASE_DN="dc=stumv,dc=de"
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=false
LDAP_HOST_PORT=13389
# phpLDAPadmin web UI (http://localhost:8081)
LDAP_ADMIN_PORT=8081

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

VITE_PORT=5173

# Off for now - see App\Http\Middleware\SetContentSecurityPolicy.
CSP_ENABLED=false
