# Test environment: runs the suite against the dockerised OpenLDAP (prod-faithful,
# see docker/openldap/) and a dedicated MariaDB database. Loaded automatically by
# Laravel when APP_ENV=testing (set in phpunit.xml). CI maps the same services to
# 127.0.0.1 on these ports, so this file works locally and in CI unchanged.
APP_NAME=StuMV
APP_ENV=testing
APP_KEY=base64:GszA3F2jJK0Rdh52FvnWj3MDarPc+ftA+e0MpqqbFMQ=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Dedicated test database (RefreshDatabase migrates/wipes this — never dev data).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13306
DB_DATABASE=stumv_testing
DB_USERNAME=stumv
DB_PASSWORD=local_stumv_password

# Dockerised OpenLDAP (docker/openldap). Throwaway dev bind credentials baked
# into the image's seed data — not production secrets.
LDAP_ORGANISATION="StuMV"
LDAP_LOGGING=false
LDAP_CONNECTION=default
LDAP_HOST=127.0.0.1
LDAP_PORT=13389
LDAP_USERNAME="uid=stumv,ou=Services,dc=stumv,dc=de"
LDAP_PASSWORD=stumv-not-production
LDAP_BASE_DN="dc=stumv,dc=de"
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=false

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
