APP_NAME=StuMV
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lara
DB_USERNAME=root
DB_PASSWORD=

LDAP_ORGANISATION="StuMV"
LDAP_LOGGING=true
LDAP_CONNECTION=default
LDAP_HOST=127.0.0.1
LDAP_USERNAME="cn=admin,dc=stumv,dc=de"
LDAP_PASSWORD=
LDAP_PORT=389
LDAP_BASE_DN="dc=stumv,dc=de"
LDAP_TIMEOUT=5
LDAP_TLS_VERIFY=true
# Optional CA file, defaults to the system trust store
LDAP_TLS_CACERT=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

#MEMCACHED_HOST=127.0.0.1

#REDIS_HOST=127.0.0.1
#REDIS_PASSWORD=null
#REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

## Mailman 3 (mailman:sync-lists) - Mailman Core's own REST API root, not the
## Postorius/Hyperkitty web UI. Leave MAILMAN_API_URL empty to disable syncing.
MAILMAN_API_URL=
MAILMAN_API_USER=restadmin
MAILMAN_API_KEY=
## TLS certificate check: true, false, or a path to a CA bundle (PEM).
MAILMAN_API_VERIFY_TLS=true
## Optional: write via Postorius as a list owner (for hosts whose REST API is
## read-only). MAILMAN_WEB_URL is the mailman-web root, without /postorius.
MAILMAN_WEB_URL=
MAILMAN_WEB_USER=
MAILMAN_WEB_PASSWORD=
MAILMAN_WEB_VERIFY_TLS=true
## Optional: let admins create lists from StuMV (needs a writable REST API).
## MAILMAN_LIST_OWNER is made owner of each created list, e.g. the
## MAILMAN_WEB_USER's address so Postorius writes keep working.
MAILMAN_LIST_CREATION=false
MAILMAN_LIST_OWNER=

## Footer URL destinations
# leave empty or comment out the whole line to remove the entry from the footer
IMPRINT_URL="https://open-administration.de/index.php/kontakt-und-impressum/"
PRIVACY_URL="https://open-administration.de/index.php/datenschutz/"
TERMS_URL="https://open-administration.de/index.php/nutzungsbedingungen/"
SOURCE_CODE_URL="https://github.com/openadministration/stumv"

## Name of the operator who can add/remove realm admins, shown in help texts
OPERATOR_NAME="Open Administration"

## Content-Security-Policy header - on by default. Set to false to turn it
## off entirely, e.g. while diagnosing whether it's the cause of some UI
## misbehaving (see App\Http\Middleware\SetContentSecurityPolicy).
CSP_ENABLED=true

## Inactive accounts: app:mark-inactive-accounts (daily via the scheduler,
## which needs a cron job running php artisan schedule:run every minute)
## emails everyone without a login for ACCOUNT_INACTIVE_AFTER_DAYS and marks
## the account for deletion; logging in within ACCOUNT_DELETION_GRACE_DAYS
## removes the mark. app:delete-marked-accounts (also daily) then deletes the
## accounts whose deadline passed without a login, including all linked data.
## Leave ACCOUNT_INACTIVE_AFTER_DAYS empty to turn it off.
ACCOUNT_INACTIVE_AFTER_DAYS=
ACCOUNT_DELETION_GRACE_DAYS=30

## Activity log: entries older than ACTIVITY_LOG_RETENTION_DAYS are deleted daily
## via the scheduler. Leave it empty to keep them forever.
ACTIVITY_LOG_RETENTION_DAYS=
## Sign-ins can be kept for less time; empty applies ACTIVITY_LOG_RETENTION_DAYS.
ACTIVITY_LOG_LOGIN_RETENTION_DAYS=
