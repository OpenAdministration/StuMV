includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    bootstrapFiles:
        - phpstan/bootstrap.php

    stubFiles:
        - phpstan/LdapRecordModelBuilder.stub
        - phpstan/OpenIdConnectClaims.stub

    paths:
        - app/
        - database/

    # Level 10 is the highest level.
    level: 8
