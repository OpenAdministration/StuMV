{
    "name": "openadministration/stumv",
    "type": "project",
    "version": "1.1.0",
    "description": "ldap based membership management for student bodys",
    "keywords": ["ldap", "laravel", "memership-management", "student-body"],
    "license": "AGPL",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-ldap": "*",
        "ext-pdo": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "dacoto/laravel-domain-validation": "^4.2",
        "diglactic/laravel-breadcrumbs": "^10.0",
        "directorytree/ldaprecord": "^4.0",
        "directorytree/ldaprecord-laravel": "^4.0",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^4.0",
        "jeremy379/laravel-openid-connect": "^3.3",
        "laravel/framework": "^13.20",
        "laravel/passport": "^13.0",
        "livewire/flux": "^2.11",
        "livewire/flux-pro": "^2.11",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.0.1",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.4.4",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rector/rector": "^2.5",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "rector": "@php vendor/bin/rector process",
        "rector-dry": "@php vendor/bin/rector process --dry-run",
        "test": "@php vendor/bin/pest",
        "lint": "@php vendor/bin/phpstan",
        "pint": "@php vendor/bin/pint",
        "fix": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/passport"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "flux-pro",
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    ]
}
